{% if cookiecutter.dev_container_runtime != 'none' %}
DEV_APP_PORT=8000
{% if cookiecutter.enable_notebooks == 'yes' %}
DEV_JUPYTER_PORT=8888
{% endif %}
{% if cookiecutter.enable_docs == 'yes' %}
DEV_DOCS_PORT=8001
{% endif %}
{% endif %}
{% if cookiecutter.coding_agent != 'none' %}
{% if cookiecutter.coding_agent == 'both' %}
AGENT_DEFAULT_PROVIDER=codex
{% elif cookiecutter.coding_agent == 'custom' %}
CUSTOM_AGENT_COMMAND=
CUSTOM_AGENT_ARGS=
{% endif %}
# Preferred localhost ports; agent-start selects a free alternative when needed.
AGENT_APP_PORT=18000
{% if cookiecutter.enable_notebooks == 'yes' %}
AGENT_JUPYTER_PORT=18888
{% endif %}
{% if cookiecutter.enable_docs == 'yes' %}
AGENT_DOCS_PORT=18001
{% endif %}
{% endif %}
