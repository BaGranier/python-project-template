ARG UV_VERSION=0.13.5
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv
FROM python:{{ cookiecutter.python_version }}-slim-bookworm AS base
COPY --from=uv /uv /uvx /usr/local/bin/
RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates build-essential make curl bash zsh \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --shell /bin/bash agent \
    && mkdir -p /opt/venv /home/agent/.cache/uv /home/agent/.codex /workspace \
    && chown -R agent:agent /opt/venv /home/agent /workspace
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_CACHE_DIR=/home/agent/.cache/uv \
    UV_PYTHON_DOWNLOADS=never \
    PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1
WORKDIR /workspace

FROM base AS dev
USER agent
CMD ["sleep", "infinity"]
{% if cookiecutter.enable_agent == 'yes' %}

FROM node:22.22.0-bookworm-slim AS node
FROM base AS agent
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
# Official package, stable npm dist-tag verified during template implementation.
ARG CODEX_VERSION=0.164.0
RUN npm install --global @openai/codex@${CODEX_VERSION} \
    && npm cache clean --force \
    && codex --version
ENV CODEX_HOME=/home/agent/.codex
USER agent
CMD ["sleep", "infinity"]
{% endif %}
